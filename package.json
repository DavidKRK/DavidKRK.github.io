{
  "name": "davidkrk-website",
  "version": "2.0.0",
  "description": "Site officiel DJ David KRK",
  "scripts": {
    "build": "npm run validate",
    "validate": "node -e \"JSON.parse(require('fs').readFileSync('manifest.json', 'utf8')); console.log('Static site validation passed')\"",
    "minify:css": "npx csso assets/css/style.css -o assets/css/style.min.css",
    "minify:js": "npx terser assets/js/main.js -o assets/js/main.min.js -c -m",
    "test": "npm run validate"
  },
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "drizzle-kit": "^1.0.0-beta.22",
    "terser": "^5.27.0"
  },
  "keywords": [
    "techno",
    "dj",
    "music"
  ],
  "author": "David KRK",
  "license": "MIT",
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.2",
    "drizzle-orm": "^1.0.0-beta.22"
  }
}
